# ==============================================================================
# ThreatLense BACKEND CONFIGURATION TEMPLATE
# ==============================================================================

# Database Configuration (Default: Local SQLite)
DATABASE_URL=sqlite:///./ids.db

# Cloud Supabase Database (Project: "ai based intrusion detection system", Ref: lofljkxtgdhvdfijstfs)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lofljkxtgdhvdfijstfs.supabase.co:5432/postgres
SUPABASE_URL=https://lofljkxtgdhvdfijstfs.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# JWT Authentication & Security Secrets
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Model Artifact Paths
UPLOAD_DIR=./uploads
MODEL_DIR=./models
LOG_DIR=./logs

# Ollama Remote / Local LLM Gateway Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Server & Network Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
